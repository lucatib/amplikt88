(version 1)

# Diagnostic surface-distance screens, not product certification limits.
(rule "Creepage diagnostic - HT to low voltage"
  (condition "((A.NetName == 'B_PLUS' || A.NetName == 'B_DRV' || A.NetName == 'B_V1' || A.NetName == '/V1_A' || A.NetName == '/LTP_A1' || A.NetName == '/LTP_A2') && (B.NetName == 'GND' || B.NetName == 'HEATER_A' || B.NetName == 'HEATER_B' || B.NetName == 'VBIAS_NEG' || B.NetName == 'BIAS_CCS' || B.NetName == '/OT_S_HI' || B.NetName == '/V3_K' || B.NetName == '/V4_K' || B.NetName == '/V1_G' || B.NetName == '/V1_K' || B.NetName == '/IN_RAW' || B.NetName == '/V3_G1' || B.NetName == '/V4_G1' || B.NetName == '/BIAS_A' || B.NetName == '/BIAS_B')) || ((B.NetName == 'B_PLUS' || B.NetName == 'B_DRV' || B.NetName == 'B_V1' || B.NetName == '/V1_A' || B.NetName == '/LTP_A1' || B.NetName == '/LTP_A2') && (A.NetName == 'GND' || A.NetName == 'HEATER_A' || A.NetName == 'HEATER_B' || A.NetName == 'VBIAS_NEG' || A.NetName == 'BIAS_CCS' || A.NetName == '/OT_S_HI' || A.NetName == '/V3_K' || A.NetName == '/V4_K' || A.NetName == '/V1_G' || A.NetName == '/V1_K' || A.NetName == '/IN_RAW' || A.NetName == '/V3_G1' || A.NetName == '/V4_G1' || A.NetName == '/BIAS_A' || A.NetName == '/BIAS_B'))")
  (constraint creepage (min 5mm)))

(rule "Creepage diagnostic - UL and screens to low voltage"
  (condition "((A.NetName == '/OT_UL1' || A.NetName == '/OT_UL2' || A.NetName == '/G2_V3' || A.NetName == '/G2_V4') && (B.NetName == 'GND' || B.NetName == 'HEATER_A' || B.NetName == 'HEATER_B' || B.NetName == 'VBIAS_NEG' || B.NetName == 'BIAS_CCS' || B.NetName == '/OT_S_HI' || B.NetName == '/V3_K' || B.NetName == '/V4_K' || B.NetName == '/V1_G' || B.NetName == '/V1_K' || B.NetName == '/IN_RAW' || B.NetName == '/V3_G1' || B.NetName == '/V4_G1' || B.NetName == '/BIAS_A' || B.NetName == '/BIAS_B')) || ((B.NetName == '/OT_UL1' || B.NetName == '/OT_UL2' || B.NetName == '/G2_V3' || B.NetName == '/G2_V4') && (A.NetName == 'GND' || A.NetName == 'HEATER_A' || A.NetName == 'HEATER_B' || A.NetName == 'VBIAS_NEG' || A.NetName == 'BIAS_CCS' || A.NetName == '/OT_S_HI' || A.NetName == '/V3_K' || A.NetName == '/V4_K' || A.NetName == '/V1_G' || A.NetName == '/V1_K' || A.NetName == '/IN_RAW' || A.NetName == '/V3_G1' || A.NetName == '/V4_G1' || A.NetName == '/BIAS_A' || A.NetName == '/BIAS_B'))")
  (constraint creepage (min 6.3mm)))

(rule "Creepage diagnostic - KT88 anodes to low voltage"
  (condition "((A.NetName == '/OT_A1' || A.NetName == '/OT_A2') && (B.NetName == 'GND' || B.NetName == 'HEATER_A' || B.NetName == 'HEATER_B' || B.NetName == 'VBIAS_NEG' || B.NetName == 'BIAS_CCS' || B.NetName == '/OT_S_HI' || B.NetName == '/V3_K' || B.NetName == '/V4_K' || B.NetName == '/V1_G' || B.NetName == '/V1_K' || B.NetName == '/IN_RAW' || B.NetName == '/V3_G1' || B.NetName == '/V4_G1' || B.NetName == '/BIAS_A' || B.NetName == '/BIAS_B')) || ((B.NetName == '/OT_A1' || B.NetName == '/OT_A2') && (A.NetName == 'GND' || A.NetName == 'HEATER_A' || A.NetName == 'HEATER_B' || A.NetName == 'VBIAS_NEG' || A.NetName == 'BIAS_CCS' || A.NetName == '/OT_S_HI' || A.NetName == '/V3_K' || A.NetName == '/V4_K' || A.NetName == '/V1_G' || A.NetName == '/V1_K' || A.NetName == '/IN_RAW' || A.NetName == '/V3_G1' || A.NetName == '/V4_G1' || A.NetName == '/BIAS_A' || A.NetName == '/BIAS_B'))")
  (constraint creepage (min 8mm)))

# Alta tensione verso massa (piste, pad e piano), in tre fasce secondo la tensione di lavoro
# (distanza superficiale, isolamento base, FR4, grado di inquinamento 2):
#   5 mm    B+, B_DRV, B_V1 e placche delle ECC83: fino a 470 V continui
#   6.3 mm  prese UL e griglie schermo: B+ piu' il 40% dell'oscillazione, picchi verso 650 V
#   8 mm    anodi delle KT88: picchi verso 900 V
# Le regole piu' in basso vincono: la fascia generale sta sopra, le piu' severe sotto.
(rule "HV - GND 5 mm"
  (constraint clearance (min 5mm))
  (condition "((A.hasNetclass('HV') || A.hasNetclass('HV_POWER')) && B.NetName == 'GND') || ((B.hasNetclass('HV') || B.hasNetclass('HV_POWER')) && A.NetName == 'GND')"))

(rule "UL e G2 - GND 6.3 mm"
  (constraint clearance (min 6.3mm))
  (condition "((A.NetName == '/OT_UL1' || A.NetName == '/OT_UL2' || A.NetName == '/G2_V3' || A.NetName == '/G2_V4') && B.NetName == 'GND') || ((B.NetName == '/OT_UL1' || B.NetName == '/OT_UL2' || B.NetName == '/G2_V3' || B.NetName == '/G2_V4') && A.NetName == 'GND')"))

(rule "Anodi KT88 - GND 8 mm"
  (constraint clearance (min 8mm))
  (condition "((A.NetName == '/OT_A1' || A.NetName == '/OT_A2') && B.NetName == 'GND') || ((B.NetName == '/OT_A1' || B.NetName == '/OT_A2') && A.NetName == 'GND')"))

# I fori di fissaggio vanno a telaio tramite viti e squadretta: contano come massa, stesse fasce
(rule "HV - fori di fissaggio 5 mm"
  (constraint hole_clearance (min 5mm))
  (condition "(A.hasNetclass('HV') || A.hasNetclass('HV_POWER')) && B.Pad_Type == 'NPTH, mechanical'"))

(rule "UL e G2 - fori di fissaggio 6.3 mm"
  (constraint hole_clearance (min 6.3mm))
  (condition "(A.NetName == '/OT_UL1' || A.NetName == '/OT_UL2' || A.NetName == '/G2_V3' || A.NetName == '/G2_V4') && B.Pad_Type == 'NPTH, mechanical'"))

(rule "Anodi KT88 - fori di fissaggio 8 mm"
  (constraint hole_clearance (min 8mm))
  (condition "(A.NetName == '/OT_A1' || A.NetName == '/OT_A2') && B.Pad_Type == 'NPTH, mechanical'"))

# Bordo scheda: nessun lato tocca squadretta o telaio, quindi niente fasce HV sul bordo
# (le viti di fissaggio sì, vedi le regole sui fori sopra). Le piste stanno comunque
# ad almeno 3 mm dal bordo.
(rule "Piste a 3 mm dal bordo"
  (constraint edge_clearance (min 3mm))
  (condition "A.Type == 'Track'"))

# Correnti grosse: larghezza minima
(rule "Anodi, B+ e catodi almeno 2.5 mm"
  (constraint track_width (min 2.5mm))
  (condition "A.hasNetclass('HV_POWER') || A.hasNetclass('CATHODE')"))

(rule "Secondario almeno 3 mm"
  (constraint track_width (min 3mm))
  (condition "A.hasNetclass('SPEAKER')"))

(rule "Massa a stella almeno 2.5 mm"
  (constraint track_width (min 2.5mm))
  (condition "A.hasNetclass('GND')"))

# La massa d'ingresso entra in J2 (header 2.54 mm, a 4 mm dal bordo): 2.5 mm non ci stanno.
(rule "Massa d'ingresso in J2"
  (constraint track_width (min 1mm))
  (condition "A.hasNetclass('GND') && A.intersectsCourtyard('J2')"))

# Una faccia per rete: la massa (a stella da J4.7) solo sotto, tutto il resto solo sopra, senza via
(rule "Massa solo su B.Cu"
  (layer "F.Cu")
  (constraint disallow track)
  (condition "A.NetName == 'GND'"))

# Ordine di sbroglio a due strati: massa a stella sotto, poi le linee di potenza, poi i
# segnali sopra. Dove un segnale non passa si accetta un ponticello su B.Cu, come eccezione
# nominata, scritta nella condizione cosi' che anche l'autorouter la veda:
#   /LTP_A1 (anodo LTP verso C8) e' chiuso dal gruppo di V1: passa sotto, sopra le R5,
#   dove prima c'era C18 (spostato accanto a R3).
#   /LTP_G1 (griglia LTP verso R10) e /V1_A (anodo V1 verso R5/R3) devono passare sotto
#   la pista di /LTP_K, che entra in V1 dalla chiave dello zoccolo (con la distanza HV di
#   2.5 mm e' l'unico varco), e sotto le piste dei filamenti.
#   VBIAS_NEG (bassa tensione, da J4.4 a RV1/R27 e RV2/R28) e' chiuso tra B_PLUS e le
#   piste HV da TR2 a V4: sopra farebbe 354 mm di giro, con il ponticello sotto 165 mm.
#   Filamenti (HEATER_A/B) e le reti attorno a V2 (LTP_K, V2_G2, LTP_A2) possono scendere
#   sotto anche loro. Le vie sono ammesse solo per queste reti, e l'autorouter le usa il meno
#   possibile (costo alto per via e per B.Cu).
(rule "Tutto tranne la massa solo su F.Cu"
  (layer "B.Cu")
  (constraint disallow track)
  (condition "A.NetName != 'GND' && A.NetName != '/LTP_A1' && A.NetName != '/LTP_G1' && A.NetName != '/V1_A' && A.NetName != 'VBIAS_NEG' && A.NetName != 'HEATER_A' && A.NetName != 'HEATER_B' && A.NetName != '/LTP_K' && A.NetName != '/V2_G2' && A.NetName != '/LTP_A2'"))

# Una sola misura di via su tutta la scheda, quella della classe HV: 1.6 mm, foro 0.8 mm.
# Regge la corrente dei filamenti (piste da 2 mm) e vale anche dove la classe dice 0.6/0.3.
(rule "Vie 1.6/0.8"
  (constraint via_diameter (min 1.6mm) (opt 1.6mm))
  (constraint hole_size (min 0.8mm) (opt 0.8mm))
  (condition "A.Type == 'Via'"))

(rule "Nessuna via"
  (constraint disallow via)
  (condition "A.Type == 'Via' && A.NetName != '/LTP_A1' && A.NetName != '/LTP_G1' && A.NetName != '/V1_A' && A.NetName != 'VBIAS_NEG' && A.NetName != 'HEATER_A' && A.NetName != 'HEATER_B' && A.NetName != '/LTP_K' && A.NetName != '/V2_G2' && A.NetName != '/LTP_A2'"))

# I piedini di uno zoccolo hanno la distanza della valvola, non si possono allargare.
# Le regole più in basso nel file vincono su quelle sopra.
(rule "Piedini dello zoccolo"
  (constraint clearance (min 1.2mm))
  (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.memberOfFootprint('V?') && B.memberOfFootprint('V?')"))

# KT88: il courtyard del footprint Valve_Octal_KT88 è il vetro, 52 mm di diametro.
# Nessun altro componente a meno di 4 mm dal vetro.
(rule "KT88: 4 mm dal vetro"
  (constraint courtyard_clearance (min 4mm))
  (condition "A.Reference == 'V3' || A.Reference == 'V4'"))

# Componenti dentro i 4 mm dal cerchio del vetro (52 mm), verificati sul 3D: fino a 35 mm
# d'altezza il KT88 è solo la base da 42 mm, e questi stanno sotto il bulbo. C7 e C8
# sono sul retro, lontani dal calore del vetro. Fuori dal DRC solo queste coppie.
(rule "KT88: componenti verificati sul 3D"
  (constraint courtyard_clearance (min 0mm))
  (severity ignore)
  (condition "(A.Reference == 'V3' && (B.Reference == 'R13' || B.Reference == 'R17' || B.Reference == 'R11')) || (A.Reference == 'V4' && (B.Reference == 'R14' || B.Reference == 'R18' || B.Reference == 'R20'))"))

# Piazzole dei filamenti JH1-JH4: piatte sulla scheda, verificate in 3D dall'utente, nessun
# problema sotto vetro o base delle valvole. Fuori dal DRC solo le coppie JH - valvola.
(rule "Piazzole filamenti verificate"
  (constraint courtyard_clearance (min 0mm))
  (severity ignore)
  (condition "A.Reference == 'JH?' && B.Reference == 'V?'"))
